# ─── Google Sheets Database (Required) ──────────────────────────────────────
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account — paste the entire JSON on ONE line (no line breaks)
GOOGLE_CREDENTIALS={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# ─── Discord Server & OAuth (Required for Discord Login) ──────────────────────
DISCORD_TOKEN=your_discord_bot_token_here
CLIENT_ID=your_bot_client_id_here
GUILD_ID=your_guild_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Admin Role ID OR Discord User ID for administrative rights
ADMIN_ROLE_ID=your_role_or_user_id_here

# ─── Web Application Config ──────────────────────────────────────────────────
APP_URL=http://localhost:3000
SESSION_SECRET=change_this_to_a_random_string_at_least_32_characters_long
PORT=3000

# ─── Optional Cloud Integrations ─────────────────────────────────────────────
# Google AI Studio Gemini API (for free school timetable scanning, no credit card needed at https://aistudio.google.com)
# GEMINI_API_KEY=AIzaSy...

# Google Cloud Vision OCR (optional alternative for timetable image import)
# VISION_CREDENTIALS={"type":"service_account",...}

# Cloudinary (for homework reference attachments)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret

# Web Push (for browser notifications)
# VAPID_PUBLIC_KEY=your_public_key
# VAPID_PRIVATE_KEY=your_private_key
# PUSH_SUBJECT=mailto:you@example.com
